# Local PostgreSQL settings used by docker-compose.yml.
# Copy this file to .env and replace POSTGRES_PASSWORD before sharing
# screenshots, examples, or deployment configs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pragmatic-papers

# Database connection string
DATABASE_URI=postgres://postgres:change_me@localhost:9000/pragmatic-papers

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# Used to configure Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=YOUR_GA_ID_HERE

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# GA4 Data API credentials for article recommendations
# Property ID: found in GA4 Admin > Property Settings (numeric ID)
# Service account: create in Google Cloud Console > IAM > Service Accounts
#   then grant Viewer access on the GA4 property
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used to configure whether to use local storage or S3 storage
USE_LOCAL_STORAGE=true

# Used to install optional dependency fonts
GH_FONT_READ=YOUR_SECRET_HERE

# Used to configure the log level (fatal, error, warn, info, debug, trace, silent)
# Defaults to "info" if not set. Use "debug" for local development.
PAYLOAD_LOG_LEVEL=debug


# Sentry DSN — same value for server, edge, and client
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment tag (e.g. "production", "staging"). Falls back to NODE_ENV.
# Used in Sentry's UI to filter issues by deploy environment.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Newsletter — Listmonk (self-hosted) with AWS SES as SMTP backend
# Listmonk base URL (no trailing slash). e.g. https://listmonk.example.com
LISTMONK_BASE_URL=
# Listmonk admin API credentials (Settings > Users > API user)
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Numeric ID of the Listmonk list that newsletter campaigns send to.
# Used by the admin API (creating campaigns).
LISTMONK_NEWSLETTER_LIST_ID=
# UUID of the same Listmonk list. Used by the public subscription endpoint
# (which only accepts list_uuids, not list_ids). Find both via:
#   curl -u "$LISTMONK_API_USER:$LISTMONK_API_TOKEN" "$LISTMONK_BASE_URL/api/lists" | jq '.data.results[] | {id, uuid, name}'
LISTMONK_NEWSLETTER_LIST_UUID=
# From address Listmonk passes to SES, e.g. "Pragmatic Papers <newsletter@newsletter.example.com>"
NEWSLETTER_FROM_EMAIL=

# Cloudflare Turnstile — bot mitigation for the newsletter signup form.
# Both keys are required; the route handler rejects unverified submits.
# Defaults below are Cloudflare's "always passes" test keys, suitable for
# local development. Replace with real keys (Cloudflare dashboard →
# Turnstile → Add site) in any deployed environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
