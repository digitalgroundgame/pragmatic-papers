legacy-peer-deps=true
enable-pre-post-scripts=true
@digitalgroundgame:registry=https://npm.pkg.github.com
# No credentials here. pnpm stops expanding ${VAR} in a committed project .npmrc's auth
# settings, since a change to this file could send the token to another registry (#955).
# The GitHub Packages token goes in a user-level .npmrc instead; see "Private Font Setup"
# in README.md. CI and the Dockerfiles write that line themselves.
