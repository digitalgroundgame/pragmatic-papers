// The published Storybook: a static-assets-only Cloudflare Worker, deployed by
// CI's "Deploy Storybook" job (.github/workflows/ci.yml) from the build the
// Storybook job has already tested. Paths resolve relative to this file.
{
  "name": "pragmatic-papers-storybook",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../storybook-static",
  },
  "workers_dev": true,
  // Each PR is a Worker Preview named `pr-<number>` (`wrangler preview`),
  // served on workers.dev, and deleted when the PR closes
  // (.github/workflows/storybook-close.yml). A static Storybook needs no
  // Preview-specific settings, but `wrangler preview` requires the block.
  "preview_urls": true,
  "previews": {},
}
