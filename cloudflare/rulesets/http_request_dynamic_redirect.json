{
  "rules": [
    {
      "description": "www to apex",
      "expression": "(http.host eq \"www.pragmaticpapers.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://pragmaticpapers.com\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      }
    }
  ]
}
