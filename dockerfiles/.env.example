# Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# For use with Coolify, set these environment variables in the Coolify UI
#
# ==============================================================
# COOLIFY BUILD SECRETS (IMPORTANT)
# ==============================================================
# These variables MUST have "Use Docker Build Secrets" ENABLED in Coolify
# so they're injected via BuildKit --mount=type=secret, never baked into layers:
#
#   - DATABASE_URI          (Build + Runtime + Build Secrets)
#   - PAYLOAD_SECRET        (Build + Runtime + Build Secrets)
#   - S3_ACCESS_KEY_ID      (Build + Runtime + Build Secrets)
#   - S3_SECRET_ACCESS_KEY  (Build + Runtime + Build Secrets)
#   - GH_FONT_READ          (Build + Build Secrets)
#
# All other variables below are non-sensitive — use standard toggles.
# ==============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=main_db
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=200

# preview: appends COOLIFY_FQDN prefix to database names (e.g. pragmatic_papers_pr_330)
# staging/production: uses DATABASE_URI as-is
BUILD_ENV=staging

# Automatically set by Coolify for preview deployments (e.g. "pr-330.pragmaticpapers.com")
# Leave empty for staging/production
COOLIFY_FQDN=

# GitHub Packages PAT with read:packages scope (for @digitalgroundgame fonts)
# COOLIFY: Build + Build Secrets
# NOTE: PATs expire. When this token lapses the build does NOT fail on its own — the
# private package is an optionalDependency, so pnpm skips it and the site silently ships
# the bundled Inter fallback instead of FKScreamer. The Dockerfile sets FONTS_REQUIRED=true
# so deploy builds fail loudly instead; see scripts/install-fonts.ts.
# After rotating the token, rebuild WITHOUT cache — the pnpm store is a cache mount keyed on
# the lockfile, so a normal rebuild reuses a store that is still missing the font package.
GH_FONT_READ=YOUR_GITHUB_TOKEN_HERE

# COOLIFY: Build + Runtime + Build Secrets
# Preview renames DB: "pragmatic_papers" -> "pragmatic_papers_pr_330" when COOLIFY_FQDN is set
DATABASE_URI=postgresql://postgres:your_secure_password_here@postgres:5432/pragmatic_papers

# Previews only: starts the preview database as a copy of DATABASE_URI's database
COPY_SOURCE_DATABASE=false

# WARNING: drops existing target database before copy. Only for rebuild scenarios.
FORCE_DATABASE_COPY=false

# COOLIFY: Build + Runtime + Build Secrets
PAYLOAD_SECRET=your_secret_key_here

USE_LOCAL_STORAGE=true

S3_REGION=us-east-1
S3_BUCKET=pragmatic-papers-staging
# COOLIFY: Build + Runtime + Build Secrets
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=https://s3.amazonaws.com

# Fine-grained GitHub PAT with contents:read on the private court-tracker repo — the Federal
# Courts interactive's data feed. Read only by the scheduled sync job, never at build time.
# COOLIFY: Runtime
# NOTE: without it the sync logs a warning and skips; the page still renders from whatever
# snapshot was last published, so a missing/expired token fails silently rather than breaking
# the build. Rotate here on expiry — nothing else needs to change.
COURT_TRACKER_GITHUB_TOKEN=your_fine_grained_pat
# Override only to point the feed at a different repo (default: digitalgroundgame/court-tracker).
# COURT_TRACKER_REPO=

# Cloudflare edge-cache purge — run after an editor's save (Site Settings, Header, Footer, a
# published article, volume, page, …) so anonymous readers see it now instead of when the
# edge's copy expires. Purges this deployment's SERVER_URL hostname only, since production,
# staging and the previews share one zone.
# COOLIFY: Runtime (production, staging and preview variables alike)
# The zone's ID is on its Overview page. The token is a custom API token with
# Zone → Cache Purge → Purge, on this zone only — not CLOUDFLARE_API_TOKEN (CI's Storybook
# deploy) and not the Cache Rules tokens. Unset, each save logs that the purge was skipped.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Home page ticker (the "Home page ticker" experiment in Site Settings). Each source is skipped
# with a "[ticker] skipping …" log line until it's set; the build never reads them.
# COOLIFY: Runtime (production, staging and preview variables alike)
# A YouTube Data API v3 key. One key can serve all three apps: each check costs one of its
# 10,000 free daily units per channel plus one, at most every 5 minutes, and only while Home
# is being visited.
YOUTUBE_API_KEY=
# App-only token; reading posts needs a paid X API plan. Unset, the ticker shows Bluesky only.
X_BEARER_TOKEN=
# The channels and accounts are set in the admin (System → Integrations); these are fallbacks.
# YOUTUBE_CHANNEL_IDS=
# X_USERNAME=
# BLUESKY_HANDLE=
