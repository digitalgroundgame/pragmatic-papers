{
  "name": "pragmatic-papers",
  "version": "2.6.0",
  "description": "The Pragmatic Papers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/install-fonts.ts",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "pnpm dev:db && pnpm dev:next && pnpm dev:db-down",
    "dev:db": "docker compose -p pragmatic-papers -f docker-compose.yml up -d",
    "dev:db-nuke": "docker compose -p pragmatic-papers -f docker-compose.yml down -v",
    "dev:db-fresh": "pnpm dev:db && echo y | pnpm payload migrate:fresh && pnpm dev:db-down",
    "dev:db-down": "docker compose -p pragmatic-papers -f docker-compose.yml down",
    "dev:next": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 8000 --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:ci": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings 0",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "reinstall": "node scripts/clean.mjs && pnpm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "check-types": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "ci": "payload migrate && pnpm build",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "postmigrate:create": "prettier --write src/migrations",
    "migrate:redo": "node scripts/redo-last-migration.mjs",
    "migrate:status": "payload migrate:status",
    "prepare": "husky",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:scripts": "vitest --project scripts",
    "test:unit:coverage": "vitest run --project unit --project scripts --coverage",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:all": "E2E_ALL_BROWSERS=true node scripts/test-e2e.mjs",
    "test:e2e:update-snapshots": "tsx scripts/test-e2e-docker.ts",
    "release": "tsx scripts/release.ts",
    "hotfix": "tsx scripts/hotfix.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google-analytics/data": "^7.2.0",
    "@next/third-parties": "16.3.6",
    "@payloadcms/admin-bar": "^3.90.1",
    "@payloadcms/db-postgres": "^3.90.1",
    "@payloadcms/live-preview-react": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/plugin-form-builder": "^3.90.1",
    "@payloadcms/plugin-nested-docs": "^3.90.1",
    "@payloadcms/plugin-redirects": "^3.90.1",
    "@payloadcms/plugin-search": "^3.90.1",
    "@payloadcms/plugin-seo": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@payloadcms/storage-s3": "^3.90.1",
    "@payloadcms/ui": "^3.90.1",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.75.2",
    "@wrksz/themes": "^2.0.2",
    "better-react-mathjax": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "feed": "^6.0.0",
    "graphql": "^16.13.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-sitemap": "^4.2.3",
    "payload": "^3.90.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.0",
    "react-hook-form": "^7.88.0",
    "sanitize-html": "^2.17.7",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@digitalgroundgame/fonts": "1.2.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^10"
  }
}
