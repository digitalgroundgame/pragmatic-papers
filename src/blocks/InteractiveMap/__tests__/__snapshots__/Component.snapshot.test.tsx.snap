// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InteractiveMapBlock > renders a single map with diverging color scale 1`] = `
<figure
  class="not-prose col-start-2 my-8 space-y-2"
>
  <div
    aria-label="Interactive map widget"
    class="flex flex-col gap-3 sm:flex-row sm:items-start"
    role="group"
  >
    <figure
      class="min-w-0 flex-1"
    >
      <figcaption
        class="mb-1 text-center text-sm font-medium"
      >
        119th Congress
      </figcaption>
      <svg
        preserveAspectRatio="xMidYMid meet"
        style="display: block; height: auto; width: 100%;"
        viewBox="0 0 10 10"
      >
        <g>
          <path
            aria-label="District 1: R+12.5"
            d="M0 0H10V10H0Z"
            data-interactive-map-path=""
            fill="#da685f"
            stroke="#ffffff"
            stroke-width="1.5"
            style="cursor: pointer; outline: none;"
            tabindex="0"
            vector-effect="non-scaling-stroke"
          />
          <path
            class="pointer-events-none"
            d=""
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            style="visibility: hidden;"
            vector-effect="non-scaling-stroke"
          />
        </g>
      </svg>
    </figure>
  </div>
  <figcaption
    class="text-lg font-semibold"
  >
    Missouri
  </figcaption>
  <p
    class="text-muted-foreground text-xs"
  >
    Source
    :
     
    <a
      class="underline"
      href="https://example.com"
      rel="noopener noreferrer"
      target="_blank"
    >
      U.S. Census
    </a>
  </p>
</figure>
`;
