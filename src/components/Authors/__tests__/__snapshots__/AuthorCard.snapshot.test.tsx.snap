      >
        <span
          class="bg-foreground text-background flex size-full items-center justify-center rounded-full font-serif text-sm group-data-[size=sm]/avatar:text-xs"
          data-slot="avatar-fallback"
        >
          AS
        </span>
      </span>
    </a>
    <div
      class="flex flex-col justify-between space-y-2"
    >
      <div
        class="flex-1 space-y-1"
      >
