          >
            <a
              class="text-primary hover:text-primary/80"
              href="/authors/alice-smith"
            >
              Alice Smith
            </a>
          </h3>
        </div>
      </div>
      <div
        data-testid="author-links"
      />
    </div>
  </div>
</div>
`;

