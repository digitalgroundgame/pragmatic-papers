  </label>
</div>
`;

exports[`FieldDescription > renders with text 1`] = `
<p
  class="text-muted-foreground text-left text-sm leading-normal font-normal group-has-data-horizontal/field:text-balance [[data-variant=legend]+&]:-mt-1.5 last:mt-0 nth-last-2:-mt-1 [&>a:hover]:text-primary [&>a]:underline [&>a]:underline-offset-4"
  data-slot="field-description"
>
  Helper text here.
</p>
`;

exports[`FieldError > renders a single error from the errors prop 1`] = `
<div
  class="text-destructive text-sm font-normal"
  data-slot="field-error"
  role="alert"
>
  Too short
</div>
`;

exports[`FieldError > renders multiple errors as a list 1`] = `
<div
  class="text-destructive text-sm font-normal"
  data-slot="field-error"
  role="alert"
>
  <ul
    class="ml-4 flex list-disc flex-col gap-1"
  >
    <li>
      Too short
    </li>
    <li>
      Invalid characters
    </li>
  </ul>
</div>
`;

