          "children": [
            {
              "mode": "normal",
              "text": "Fill in ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Math Expression",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " with the LaTeX. Use ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Description",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " to say what the formula is in plain words: screen readers and the narration voice read it instead of the symbols.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
