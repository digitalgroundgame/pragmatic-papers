        {
          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Who has a page",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Everyone with a staff role (writer, narrator, editor, chief editor, admin) has a public page. So does anyone an article credits as an author, or a recording credits as its narrator: they get ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Public author page",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " ticked automatically, which keeps their page and bylines working even if their role changes later.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Admins and chief editors can tick or untick ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Public author page",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " by hand, and they can edit anyone's profile. Everyone else can edit only their own.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
