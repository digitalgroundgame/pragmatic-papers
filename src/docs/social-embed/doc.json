          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Good to know",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
