          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "When you save or publish, we fetch the post and keep a copy with the article. While the post is live, readers get the platform's own interactive version. We check back about once a month; if the post has since been deleted or made private, readers see our saved copy instead of a blank space.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "If we couldn't fetch the post at all when you saved (a typo, a private account, the platform was down), readers get a small notice with a link to view it on the platform. Check the preview after publishing, and save again once the link works.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
