{
  "title": "Tag articles with topics",
  "summary": "Topics group articles by subject. Each one gets its own page listing its articles, and readers see an article's topics as links.",
  "publishedAt": "2026-03-09",
  "heroImage": {
    "$media": "hero.webp",
    "alt": "Three topic tags on an article: Elections, Housing and Courts"
  },
  "section": "writing",
  "audience": ["writer", "editor"],
