          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Changing a slug changes the topic page's address, and the old address isn't redirected. Avoid renaming slugs of topics that have been shared or linked from the header or footer.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
