{
  "title": "Who can write, publish and schedule an article",
  "summary": "Writers draft their own articles and editors publish them. Your work saves itself as you go, and Live Preview shows it as readers will see it.",
  "publishedAt": "2025-07-01",
  "heroImage": {
    "$media": "hero.webp",
    "alt": "An article title with its published and updated dates"
  },
  "audience": ["writer", "editor"],
  "content": {
    "root": {
      "type": "root",
      "format": "",
      "indent": 0,
      "version": 1,
      "children": [
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Every article starts as a draft. Readers only see it once it's published, and only editors can publish.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Writers",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "tag": "ul",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Create articles and edit the ones ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "you created",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": ", whether they're drafts or already published.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "You can't publish, and you can't change a published article's live version. When a draft is ready, tell an editor.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "You can delete articles you created.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            }
          ],
          "listType": "bullet",
          "direction": null
        },
        {
          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Editors",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Editors, chief editors and admins can edit, publish, schedule and delete any article. They also have two sidebar fields writers can't change:",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
          "tag": "ul",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Published At",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": ": the date shown on the article. Left empty, it's set to the moment the article is first published.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Syndicate to Substack",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": ": adds the article to the feed Substack imports from, once it's published.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            }
          ],
          "listType": "bullet",
          "direction": null
        },
        {
          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Saving and versions",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Changes save themselves as a draft while you type, so there's no Save button to forget. The last 50 versions are kept; the ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Versions",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " tab lets you compare them or restore one.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
          "tag": "h2",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Live Preview",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "Live Preview",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " in the top bar shows the draft beside the editor, laid out as readers will see it and updating as you type. ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Preview",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " opens the same view in its own tab.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
          "textStyle": "",
          "textFormat": 0
        },
        {
