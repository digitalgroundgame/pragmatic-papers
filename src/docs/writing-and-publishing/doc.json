              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "mode": "normal",
              "text": "To publish later, an editor opens the menu beside ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Publish changes",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": " and picks ",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            },
            {
              "mode": "normal",
              "text": "Schedule Publish",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 1,
              "version": 1
            },
            {
              "mode": "normal",
              "text": ", then a date and time. The article goes live on its own at that time.",
              "type": "text",
              "style": "",
              "detail": 0,
              "format": 0,
              "version": 1
            }
          ],
          "direction": null,
